{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "react": ["preact/compat"],
      "react/jsx-runtime": ["preact/jsx-runtime"],
      "react-dom": ["preact/compat"],
      "react-dom/*": ["preact/compat/*"]
    }
  }
}
